# install.sh creates .env from this file. Git ignores .env, so these values stay off GitHub.

# Unraid's default user and group
PUID=99
PGID=100
TZ=Etc/UTC

# Where things live on the Unraid host
APPDATA=/mnt/user/appdata
DATA_ROOT=/mnt/user/data

# slskd web login: choose your own
SLSKD_WEB_USERNAME=
SLSKD_WEB_PASSWORD=

# Your Soulseek account
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# install.sh fills these in
LIDARR_API_KEY=
VIDARR_API_KEY=

SYNC_INTERVAL_MINUTES=60
